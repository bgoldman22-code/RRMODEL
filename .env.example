# Environment Variables for NBA Props Phase 3
# DO NOT commit actual keys to git!

# TheOddsAPI Key (required for historical odds collection)
# Get your key at: https://the-odds-api.com/
# ODDS_API_KEY=your_key_here
ODDS_API_KEY=

# Optional: Override default date range for historical collection
# HISTORICAL_START_DATE=2022-11-01
# HISTORICAL_END_DATE=2025-04-15
# HISTORICAL_SAMPLE_SIZE=60
