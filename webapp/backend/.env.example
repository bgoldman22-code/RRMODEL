# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/mlb_rr_model
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mlb_rr_model
DATABASE_USER=postgres
DATABASE_PASSWORD=password

# API Keys
ODDS_API_KEY=your_odds_api_key_here
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# Server Configuration
PORT=5000
NODE_ENV=development
API_VERSION=v1

# Odds API Settings
ODDS_API_SPORT=baseball_mlb
ODDS_API_REGION=us
ODDS_API_MARKET=batter_home_runs
ODDS_API_ODDS_FORMAT=decimal
ODDS_UPDATE_INTERVAL=300000

# Injury API Settings (if using)
ROTOWIRE_API_KEY=your_rotowire_key_here
INJURY_UPDATE_INTERVAL=600000

# Bankroll Settings
STARTING_BANKROLL=10000
KELLY_FRACTION=0.25
MAX_DAILY_RISK_PCT=0.10
MAX_BET_SIZE_PCT=0.05
DEFAULT_UNIT_SIZE=10

# JWT Authentication
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# CORS
CORS_ORIGIN=http://localhost:3000

# Model Settings
HR_SCORE_WEIGHT_HR_RATE=0.50
HR_SCORE_WEIGHT_ISO=0.25
HR_SCORE_WEIGHT_HR_FB=0.15
HR_SCORE_WEIGHT_HARD_PCT=0.10
MIN_ODDS=2.5
MAX_ODDS=10.0
TOP_PLAYERS_COUNT=30
