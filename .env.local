# TheOddsAPI Key - Local Development
# Get your free API key from https://the-odds-api.com/
# Free tier: 500 requests/month

# STEP 1: Visit https://the-odds-api.com/ and sign up for free
# STEP 2: Replace 'YOUR_ACTUAL_API_KEY_HERE' with your real API key
REACT_APP_ODDS_API_KEY=YOUR_ACTUAL_API_KEY_HERE

# Debug logging (shows detailed API calls in browser console)
REACT_APP_ENABLE_DEBUG_LOGS=true