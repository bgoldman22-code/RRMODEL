# netlify.toml.fragment — merge this into your real netlify.toml (ensure only ONE [functions] block total)
[functions]
  node_bundler = "esbuild"
  external_node_modules = ["@netlify/blobs","csv-parse"]
  included_files = ["netlify/functions/**/_data/**"]

